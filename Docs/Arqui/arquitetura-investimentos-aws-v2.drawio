        <mxCell id="cfgmapr6c0" value="feature flag por provedor" style="shape=partialRectangle;connectable=0;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;spacingRight=4;overflow=hidden;html=1;whiteSpace=wrap;fontSize=11;fillColor=none;fontColor=#545B64;" vertex="1" parent="cfgmapr6"><mxGeometry x="0" width="420" height="30" as="geometry"><mxRectangle width="420" height="30" as="alternateBounds" /></mxGeometry></mxCell>

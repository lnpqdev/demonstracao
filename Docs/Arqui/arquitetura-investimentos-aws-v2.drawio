        <mxCell id="cfgmapr6c2" value="Feature flag" style="shape=partialRectangle;connectable=0;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;spacingRight=4;overflow=hidden;html=1;whiteSpace=wrap;fontSize=11;fillColor=none;fontColor=#545B64;" vertex="1" parent="cfgmapr6"><mxGeometry x="720" width="280" height="30" as="geometry"><mxRectangle width="280" height="30" as="alternateBounds" /></mxGeometry></mxCell>
        <mxCell id="cfgmapr6c3" value="provedor4_habilitado = false" style="shape=partialRectangle;connectable=0;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;spacingRight=4;overflow=hidden;html=1;whiteSpace=wrap;fontSize=11;fillColor=none;fontColor=#545B64;" vertex="1" parent="cfgmapr6"><mxGeometry x="1000" width="350" height="30" as="geometry"><mxRectangle width="350" height="30" as="alternateBounds" /></mxGeometry></mxCell>
        <mxCell id="n3a" value="Por que os endpoints ficam fora da imagem: trocar a URL de homologacao de um provedor vira mudanca de parametro, nao build + deploy. E o mesmo artefato sobe em dev, hml e prd." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="960" width="900" height="60" as="geometry" /></mxCell>
        <mxCell id="n3b" value="Injecao no boot: a task role le os parametros e secrets; o Spring carrega via spring-cloud-aws (ou o container le no startup). Nada de URL em variavel de ambiente fixa no task definition versionado." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="980" y="960" width="900" height="60" as="geometry" /></mxCell>
        <mxCell id="n3c" value="Sem banco de dados, cada chamada do cliente vira chamada ao provedor. Defina timeout AGRESSIVO por endpoint (coluna da pagina 2) e um budget total por rota do BFF - senao uma API lenta derruba a rota inteira." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#8B0F18;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="1040" width="1840" height="50" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pg4" name="4 - Task definition e Datadog">
    <mxGraphModel dx="1800" dy="1100" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1950" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t4" value="Composicao do ECS Task e observabilidade Datadog" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=19;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1600" height="34" as="geometry" /></mxCell>
        <mxCell id="tdBox" value="ECS Task Definition - servico fundos (blueprint para cdb e renda-fixa)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDF3EA;strokeColor=#ED7100;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontColor=#B35B00;fontSize=14;fontStyle=1;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="900" height="640" as="geometry" /></mxCell>
        <mxCell id="c1" value="1. init container: dd-lib-java-init&lt;br&gt;copia dd-java-agent.jar para volume compartilhado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontSize=11;dashed=0;align=left;spacingLeft=8;fontColor=#232F3E;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="140" width="840" height="60" as="geometry" /></mxCell>
        <mxCell id="c2" value="2. app (essential=true) - imagem do ECR&lt;br&gt;Spring Boot, hexagonal, porta 8080&lt;br&gt;depende da lib provider-clients (CodeArtifact)&lt;br&gt;JAVA_TOOL_OPTIONS=-javaagent:/dd/dd-java-agent.jar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE5CC;strokeColor=#ED7100;fontSize=11;dashed=0;align=left;spacingLeft=8;fontColor=#232F3E;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="215" width="840" height="90" as="geometry" /></mxCell>
        <mxCell id="c3" value="3. datadog-agent (sidecar)&lt;br&gt;ECS_FARGATE=true | DD_APM_ENABLED=true&lt;br&gt;DD_APM_NON_LOCAL_TRAFFIC=true | DD_DOGSTATSD_NON_LOCAL_TRAFFIC=true&lt;br&gt;DD_API_KEY via secrets do task definition&lt;br&gt;~0.25 vCPU / 0.5 GB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#632CA6;fontSize=11;dashed=0;align=left;spacingLeft=8;fontColor=#232F3E;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="320" width="840" height="100" as="geometry" /></mxCell>
        <mxCell id="c4" value="4. log-router (FireLens / Fluent Bit)&lt;br&gt;logDriver=awsfirelens, output datadog&lt;br&gt;DD_LOGS_INJECTION=true correlaciona log e trace" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#632CA6;fontSize=11;dashed=0;align=left;spacingLeft=8;fontColor=#232F3E;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="435" width="840" height="70" as="geometry" /></mxCell>
        <mxCell id="c5" value="Task Role: ssm:GetParameters, secretsmanager:GetSecretValue, (opcional) s3:PutObject&lt;br&gt;Execution Role: pull do ECR + leitura dos secrets no start&lt;br&gt;Nenhuma credencial de provedor dentro da imagem" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C7131F;fontSize=11;dashed=0;align=left;spacingLeft=8;fontColor=#232F3E;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="520" width="840" height="80" as="geometry" /></mxCell>
        <mxCell id="c6" value="Para CDB e Renda Fixa muda apenas: imagem, DD_SERVICE, target group e o prefixo dos parametros.&lt;br&gt;Sidecars, roles e observabilidade sao identicos." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#B35B00;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="70" y="615" width="840" height="70" as="geometry" /></mxCell>

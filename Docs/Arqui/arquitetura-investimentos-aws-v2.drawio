        <mxCell id="cdbSvc" value="Servico: cdb (FUTURO)&lt;br&gt;&lt;br&gt;Mesmo blueprint de task.&lt;br&gt;Mesma lib provider-clients.&lt;br&gt;&lt;br&gt;Novo target group tg-cdb&lt;br&gt;Nova regra no ALB: /cdb/*&lt;br&gt;&lt;br&gt;A borda nao muda: o BFF&lt;br&gt;so publica a nova rota." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontColor=#545B64;fontSize=10;fontStyle=1;dashed=1;align=center;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1030" y="680" width="300" height="380" as="geometry" /></mxCell>

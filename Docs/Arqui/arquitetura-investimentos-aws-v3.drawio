        <mxCell id="firelens" value="sidecar: FireLens (logs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#632CA6;fontSize=10;dashed=0;align=center;spacingLeft=8;fontColor=#232F3E;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="994" width="240" height="32" as="geometry" /></mxCell>
        <mxCell id="portNote" value="porta 8080 - so o SG do ALB entra" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=9;fontColor=#545B64;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="740" y="1032" width="240" height="30" as="geometry" /></mxCell>
        <mxCell id="cdbSvc" value="Servico: cdb (FUTURO)&lt;br&gt;&lt;br&gt;Mesmo blueprint de task.&lt;br&gt;Mesma lib provider-clients.&lt;br&gt;&lt;br&gt;Novo target group tg-cdb&lt;br&gt;Nova regra no ALB: /cdb/*&lt;br&gt;&lt;br&gt;Pode reusar os MESMOS&lt;br&gt;gateways de provedor,&lt;br&gt;so mudam os paths." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;verticalAlign=top;align=center;spacingLeft=10;spacingTop=4;fontColor=#545B64;fontSize=10;fontStyle=0;dashed=1;" vertex="1" parent="1"><mxGeometry x="1030" y="680" width="300" height="420" as="geometry" /></mxCell>
        <mxCell id="rfSvc" value="Servico: renda-fixa (FUTURO)&lt;br&gt;&lt;br&gt;Mesmo blueprint de task.&lt;br&gt;Mesma lib provider-clients.&lt;br&gt;&lt;br&gt;Novo target group tg-renda-fixa&lt;br&gt;Nova regra: /renda-fixa/*&lt;br&gt;&lt;br&gt;Deploy e escala independentes&lt;br&gt;por contexto de negocio." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;verticalAlign=top;align=center;spacingLeft=10;spacingTop=4;fontColor=#545B64;fontSize=10;fontStyle=0;dashed=1;" vertex="1" parent="1"><mxGeometry x="1350" y="680" width="300" height="420" as="geometry" /></mxCell>
        <mxCell id="cfgBox" value="Configuracao e segredos - E AQUI QUE OS ENDPOINTS FICAM (nunca no codigo, nunca na imagem)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5EFFF;strokeColor=#8C4FFF;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontColor=#6B2FD6;fontSize=12;fontStyle=1;dashed=0;" vertex="1" parent="1"><mxGeometry x="370" y="1170" width="1340" height="150" as="geometry" /></mxCell>
        <mxCell id="ssm" value="SSM Parameter Store&lt;br&gt;base-url do gateway&lt;br&gt;+ path por operacao" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientDirection=north;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.systems_manager;gradientColor=#F34482;fillColor=#BC1356;" vertex="1" parent="1"><mxGeometry x="430" y="1210" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="secrets" value="Secrets Manager&lt;br&gt;subscription key / client secret&lt;br&gt;certs mTLS - 1 por gateway" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientDirection=north;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;gradientColor=#F54749;fillColor=#C7131F;" vertex="1" parent="1"><mxGeometry x="650" y="1210" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="pca" value="ACM Private CA&lt;br&gt;mTLS" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientDirection=north;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.certificate_manager;gradientColor=#F54749;fillColor=#C7131F;" vertex="1" parent="1"><mxGeometry x="890" y="1210" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="appcfg" value="AppConfig&lt;br&gt;feature flag por gateway&lt;br&gt;(desligar provedor em incidente)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientDirection=north;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.appconfig;gradientColor=#F34482;fillColor=#BC1356;" vertex="1" parent="1"><mxGeometry x="1090" y="1210" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="s3" value="S3 Object Lock (opcional)&lt;br&gt;trilha de auditoria imutavel" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientDirection=north;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;gradientColor=#60A337;fillColor=#277116;opacity=60;" vertex="1" parent="1"><mxGeometry x="1330" y="1210" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="cicd" value="CI/CD e Artefatos" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F8FF;strokeColor=#3334B9;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontColor=#3334B9;fontSize=11;fontStyle=1;dashed=0;" vertex="1" parent="1"><mxGeometry x="1790" y="400" width="400" height="300" as="geometry" /></mxCell>
        <mxCell id="cart" value="CodeArtifact" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientDirection=north;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.codeartifact;gradientColor=#4D72F3;fillColor=#3334B9;" vertex="1" parent="1"><mxGeometry x="1840" y="445" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="ecr" value="ECR" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientDirection=north;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecr;gradientColor=#F78E04;fillColor=#D05C17;" vertex="1" parent="1"><mxGeometry x="1970" y="445" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="cbuild" value="CodeBuild" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientDirection=north;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.codebuild;gradientColor=#4D72F3;fillColor=#3334B9;" vertex="1" parent="1"><mxGeometry x="2100" y="445" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="cicdText" value="lib provider-clients = JAR versionado (semver), so transporte:&lt;br&gt;um HTTP client por GATEWAY de provedor, mTLS, timeout, retry com&lt;br&gt;jitter, tratamento de 429/Retry-After, circuit breaker e bulkhead.&lt;br&gt;URL e paths NAO sao compilados: vem do Parameter Store no boot." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1810" y="555" width="365" height="130" as="geometry" /></mxCell>
        <mxCell id="awsObs" value="Telemetria nativa AWS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDF0F5;strokeColor=#E7157B;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontColor=#B01060;fontSize=11;fontStyle=1;dashed=0;" vertex="1" parent="1"><mxGeometry x="1790" y="730" width="400" height="170" as="geometry" /></mxCell>
        <mxCell id="cw" value="CloudWatch" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientDirection=north;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;gradientColor=#F34482;fillColor=#BC1356;" vertex="1" parent="1"><mxGeometry x="1830" y="770" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="cwText" value="Container Insights e metricas de ALB,&lt;br&gt;API Gateway e Fargate.&lt;br&gt;Coletadas pela AWS Integration do Datadog.&lt;br&gt;O painel unico e o Datadog." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1910" y="765" width="265" height="120" as="geometry" /></mxCell>
        <mxCell id="ddBox" value="Datadog (SaaS)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#632CA6;verticalAlign=top;align=center;spacingTop=8;fontColor=#632CA6;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2320" y="380" width="420" height="330" as="geometry" /></mxCell>
        <mxCell id="ddText" value="- APM: span de saida com tag provider + gateway + operation&lt;br&gt;- Logs correlacionados (dd.trace_id)&lt;br&gt;- Metricas custom: 429 por gateway, saturacao do pool,&lt;br&gt;  estado do circuit breaker, hit ratio do Caffeine&lt;br&gt;- Synthetics: 1 teste por gateway de provedor&lt;br&gt;- RUM (app / web) e AWS Integration&lt;br&gt;- SLO de latencia e erro POR ENDPOINT&lt;br&gt;&lt;br&gt;Sem DBM: nao ha banco de dados." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#432466;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="2340" y="415" width="385" height="285" as="geometry" /></mxCell>
        <mxCell id="provBox" value="Provedores externos - cada API tem SEU PROPRIO GATEWAY&lt;br&gt;(1 host, N endpoints - detalhe na pagina 2)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFEFEF;strokeColor=#545B64;verticalAlign=top;align=center;spacingTop=6;fontColor=#232F3E;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2320" y="760" width="420" height="580" as="geometry" /></mxCell>

        <mxCell id="initC" value="init: dd-java-agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#632CA6;fontSize=10;dashed=0;align=center;spacingLeft=8;fontColor=#232F3E;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="738" width="240" height="32" as="geometry" /></mxCell>

        <mxCell id="caffeine" value="CACHE EM PROCESSO (Caffeine)&lt;br&gt;cadastro, calendario, token OAuth2&lt;br&gt;TTL curto - NUNCA cota/saldo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F6E6;strokeColor=#277116;fontSize=9;dashed=0;align=center;spacingLeft=8;fontColor=#232F3E;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="832" width="240" height="58" as="geometry" /></mxCell>

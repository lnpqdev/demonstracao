        <mxCell id="p2hint" value="Sem banco local, a coluna &#x27;Chave de idempotencia&#x27; e o que torna o retry seguro: preencha com o header que aquele gateway aceita (Idempotency-Key, requestId...). Onde o gateway nao suportar, marque &#x27;NAO&#x27; e desligue o retry naquele endpoint - repetir um POST de aplicacao sem idempotencia pode gerar ordem duplicada." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#8B0F18;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="1690" width="1900" height="60" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>

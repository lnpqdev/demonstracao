        <mxCell id="valkeyN" value="So entra quando houver estado&lt;br&gt;COMPARTILHADO entre as tasks:&lt;br&gt;dedup de webhook, rate limit&lt;br&gt;global contra o gateway do&lt;br&gt;provedor, lock distribuido.&lt;br&gt;Nao usar para cache simples." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=9;fontColor=#545B64;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="380" y="830" width="240" height="95" as="geometry" /></mxCell>

  <diagram id="pg1" name="1 - Arquitetura AWS (stateless + gateways por provedor)">
    <mxGraphModel dx="1800" dy="1100" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2800" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" value="Plataforma de Investimentos - servico stateless | Fundos hoje, CDB e Renda Fixa depois | entrada unica pelo API Gateway do BFF | saida por 1 GATEWAY POR PROVEDOR" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=19;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2200" height="34" as="geometry" /></mxCell>
        <mxCell id="t1b" value="Cada API externa tem gateway proprio: 1 host, N endpoints. Por isso pool de conexao, credencial, circuit breaker e bulkhead sao POR GATEWAY - e os paths sao por operacao (paginas 2 e 3)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#545B64;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="2200" height="26" as="geometry" /></mxCell>

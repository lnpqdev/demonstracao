        <mxCell id="e19" value="imagem" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#D05C17;dashed=1;" edge="1" parent="1" source="ecr" target="ecsCluster"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="noteA" value="O gateway do provedor e a unidade de isolamento: a cota de throttling (429) e compartilhada por TODOS os endpoints daquele host. Um breaker por endpoint nao protege nada - se o gateway limitar, limita tudo. Por isso: 1 connection pool, 1 bulkhead e 1 circuit breaker por gateway, e timeout por endpoint." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#8B0F18;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="250" y="1460" width="2000" height="46" as="geometry" /></mxCell>
        <mxCell id="noteB" value="Cache: Caffeine dentro do task resolve cadastro, calendario e token do gateway sem infra nova. ElastiCache Valkey (nao Redis OSS) so na fase 2, quando o estado precisar ser compartilhado entre tasks. Cota, posicao e saldo nao entram em cache." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#277116;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="250" y="1512" width="2000" height="46" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

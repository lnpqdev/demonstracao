  <diagram id="pg1" name="1 - Camadas (Fase 1: Fundos)">
    <mxGraphModel dx="1800" dy="1100" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2820" pageHeight="2560" math="0" shadow="0">
      <root>

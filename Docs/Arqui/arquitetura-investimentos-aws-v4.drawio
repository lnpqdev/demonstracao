        <mxCell id="band1" value="Quem consome" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#545B64;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontColor=#545B64;fontSize=12;fontStyle=1;dashed=0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="320" y="140" width="1660" height="110" as="geometry" /></mxCell>
        <mxCell id="lab2" value="CAMADA 2&lt;br&gt;BORDA&lt;br&gt;entrada unica" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="310" width="230" height="160" as="geometry" /></mxCell>
        <mxCell id="band2" value="Unico ponto publico - nenhum servico de dominio e exposto aqui" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF4E6;strokeColor=#ED7100;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontColor=#B35B00;fontSize=12;fontStyle=1;dashed=0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="320" y="310" width="1660" height="160" as="geometry" /></mxCell>
        <mxCell id="lab3" value="CAMADA 3&lt;br&gt;BFF" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="510" width="230" height="140" as="geometry" /></mxCell>
        <mxCell id="band3" value="Agrega e orquestra - nao contem regra de dominio" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF9E6;strokeColor=#ED7100;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontColor=#B35B00;fontSize=12;fontStyle=1;dashed=0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="320" y="510" width="1660" height="140" as="geometry" /></mxCell>
        <mxCell id="lab4" value="CAMADA 4&lt;br&gt;ROTEAMENTO&lt;br&gt;INTERNO" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="680" width="230" height="170" as="geometry" /></mxCell>
        <mxCell id="band4" value="ALB interno - o ponto onde as fases futuras entram sem mexer nas camadas 1 a 3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2ECFF;strokeColor=#5A30B5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontColor=#5A30B5;fontSize=12;fontStyle=1;dashed=0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="320" y="680" width="1660" height="170" as="geometry" /></mxCell>
        <mxCell id="lab5" value="CAMADA 5&lt;br&gt;APLICACAO&lt;br&gt;dominio" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="860" width="230" height="480" as="geometry" /></mxCell>
        <mxCell id="band5" value="Um servico por contexto de negocio" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF7FA;strokeColor=#00A4A6;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontColor=#00787A;fontSize=12;fontStyle=1;dashed=0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="320" y="860" width="1660" height="480" as="geometry" /></mxCell>
        <mxCell id="lab6" value="CAMADA 6&lt;br&gt;CONFIGURACAO&lt;br&gt;e segredos" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="1370" width="230" height="160" as="geometry" /></mxCell>
        <mxCell id="band6" value="Onde os endpoints e credenciais vivem - fora da imagem, fora do codigo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5EFFF;strokeColor=#8C4FFF;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontColor=#6B2FD6;fontSize=12;fontStyle=1;dashed=0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="320" y="1370" width="1660" height="160" as="geometry" /></mxCell>
        <mxCell id="lab7" value="CAMADA 7&lt;br&gt;SAIDA&lt;br&gt;controlada" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="1560" width="230" height="200" as="geometry" /></mxCell>
        <mxCell id="band7" value="Todo trafego de saida por um unico IP fixo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2FAF0;strokeColor=#7AA116;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontColor=#5C7D0F;fontSize=12;fontStyle=1;dashed=0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="320" y="1560" width="1660" height="200" as="geometry" /></mxCell>
        <mxCell id="lab8" value="CAMADA 8&lt;br&gt;PROVEDORES&lt;br&gt;EXTERNOS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="1840" width="230" height="560" as="geometry" /></mxCell>
        <mxCell id="band8" value="Cada API tem SEU gateway - preencha host e endpoints direto nos blocos" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#3C4043;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontColor=#3C4043;fontSize=12;fontStyle=1;dashed=0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="320" y="1840" width="1660" height="560" as="geometry" /></mxCell>
        <mxCell id="clients" value="Apps Mobile / Web / Parceiros B2B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;fontSize=12;dashed=0;align=center;spacingLeft=8;fontColor=#232F3E;verticalAlign=middle;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="350" y="175" width="320" height="60" as="geometry" /></mxCell>
        <mxCell id="c1n" value="O cliente so conhece o dominio publico do BFF. Nenhuma rota chega direto a camada 5." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#545B64;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="700" y="180" width="1250" height="50" as="geometry" /></mxCell>
        <mxCell id="r53" value="Route 53" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientDirection=north;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.route_53;gradientColor=#945DF2;fillColor=#5A30B5;" vertex="1" parent="1"><mxGeometry x="400" y="350" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="waf" value="AWS WAF" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientDirection=north;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.waf;gradientColor=#F54749;fillColor=#C7131F;" vertex="1" parent="1"><mxGeometry x="530" y="350" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="apigw" value="API Gateway (HTTP API)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientDirection=north;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;gradientColor=#F34482;fillColor=#BC1356;" vertex="1" parent="1"><mxGeometry x="660" y="350" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="cognito" value="Cognito - JWT" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientDirection=north;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cognito;gradientColor=#F54749;fillColor=#C7131F;" vertex="1" parent="1"><mxGeometry x="800" y="350" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="c2n" value="Aqui ficam: TLS publico, WAF, autenticacao (JWT authorizer), throttling e quota por cliente.&lt;br&gt;Este e o UNICO API Gateway do desenho. Os servicos de dominio nunca ganham gateway proprio.&lt;br&gt;Adicionar CDB no futuro = publicar uma rota nova aqui, nada mais." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#B35B00;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="940" y="345" width="1010" height="110" as="geometry" /></mxCell>
        <mxCell id="bff" value="BFF - ECS Fargate" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientDirection=north;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate;gradientColor=#F78E04;fillColor=#D05C17;" vertex="1" parent="1"><mxGeometry x="400" y="540" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="c3n" value="API Gateway alcanca o BFF por VPC Link (privado). O BFF monta a resposta da tela, aplica timeout total por rota&lt;br&gt;e propaga o JWT + trace para a camada 5. Sem estado, sem cache de dado financeiro." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#B35B00;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="620" y="535" width="1330" height="90" as="geometry" /></mxCell>
        <mxCell id="alb" value="ALB INTERNO&lt;br&gt;scheme=internal" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientDirection=north;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.application_load_balancer;gradientColor=#945DF2;fillColor=#5A30B5;" vertex="1" parent="1"><mxGeometry x="400" y="710" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="rule1" value="/fundos/*   -&gt;   tg-fundos            [ATIVO - FASE 1]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F6E6;strokeColor=#277116;fontSize=11;dashed=0;align=left;spacingLeft=8;fontColor=#1B5E20;verticalAlign=middle;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="620" y="712" width="420" height="36" as="geometry" /></mxCell>
        <mxCell id="rule2" value="/cdb/*   -&gt;   tg-cdb                     [fase 2]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontSize=11;dashed=1;align=left;spacingLeft=8;fontColor=#879196;verticalAlign=middle;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="620" y="754" width="420" height="32" as="geometry" /></mxCell>
        <mxCell id="rule3" value="/renda-fixa/*   -&gt;   tg-renda-fixa   [fase 3]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontSize=11;dashed=1;align=left;spacingLeft=8;fontColor=#879196;verticalAlign=middle;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="620" y="790" width="420" height="32" as="geometry" /></mxCell>
        <mxCell id="c4n" value="Sem DNS publico e sem IP publico. O Security Group do ALB aceita SOMENTE o SG do BFF.&lt;br&gt;E nesta camada que a expansao acontece: cada fase nova = 1 target group + 1 regra de path.&lt;br&gt;As camadas 1 a 3 nao mudam quando CDB e Renda Fixa entrarem." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5A30B5;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1080" y="712" width="870" height="110" as="geometry" /></mxCell>
        <mxCell id="fase1" value="FASE 1 - EM CONSTRUCAO AGORA:  servico  fundos" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#277116;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontColor=#1B5E20;fontSize=13;fontStyle=1;dashed=0;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="350" y="895" width="690" height="430" as="geometry" /></mxCell>
        <mxCell id="taskBox" value="ECS Task Definition (Fargate)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#879196;verticalAlign=top;align=left;spacingLeft=8;fontColor=#545B64;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="370" y="945" width="300" height="360" as="geometry" /></mxCell>
        <mxCell id="initC" value="init: dd-java-agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#632CA6;fontSize=10;dashed=0;align=center;spacingLeft=8;fontColor=#232F3E;verticalAlign=middle;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="385" y="972" width="270" height="30" as="geometry" /></mxCell>
        <mxCell id="javaApp" value="App Java (Spring Boot)&lt;br&gt;hexagonal - modulo Fundos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE5CC;strokeColor=#ED7100;fontSize=10;dashed=0;align=center;spacingLeft=8;fontColor=#232F3E;verticalAlign=middle;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="385" y="1008" width="270" height="48" as="geometry" /></mxCell>
        <mxCell id="caffeine" value="CACHE EM PROCESSO (Caffeine)&lt;br&gt;cadastro, calendario, token do gateway&lt;br&gt;NUNCA cota, posicao ou saldo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F6E6;strokeColor=#277116;fontSize=9;dashed=0;align=center;spacingLeft=8;fontColor=#232F3E;verticalAlign=middle;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="385" y="1062" width="270" height="56" as="geometry" /></mxCell>
        <mxCell id="libBox" value="lib provider-clients (JAR)&lt;br&gt;1 pool + 1 breaker + 1 bulkhead&lt;br&gt;POR GATEWAY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8E8FF;strokeColor=#3334B9;fontSize=9;dashed=0;align=center;spacingLeft=8;fontColor=#232F3E;verticalAlign=middle;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="385" y="1124" width="270" height="54" as="geometry" /></mxCell>
        <mxCell id="ddAgent" value="sidecar: Datadog Agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#632CA6;fontSize=10;dashed=0;align=center;spacingLeft=8;fontColor=#232F3E;verticalAlign=middle;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="385" y="1184" width="270" height="30" as="geometry" /></mxCell>
        <mxCell id="firelens" value="sidecar: FireLens (logs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#632CA6;fontSize=10;dashed=0;align=center;spacingLeft=8;fontColor=#232F3E;verticalAlign=middle;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="385" y="1220" width="270" height="30" as="geometry" /></mxCell>
        <mxCell id="portNote" value="porta 8080 - so o SG do ALB entra" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=9;fontColor=#545B64;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="385" y="1256" width="270" height="28" as="geometry" /></mxCell>
        <mxCell id="f1n" value="Escopo fechado da Fase 1&lt;br&gt;&lt;br&gt;- target group: tg-fundos&lt;br&gt;- rota no ALB: /fundos/*&lt;br&gt;- gateways consumidos: 1, 2, 3 e 4 (camada 8)&lt;br&gt;- cache: apenas Caffeine, sem infra nova&lt;br&gt;- sem banco de dados&lt;br&gt;&lt;br&gt;Pronto quando: as 4 integracoes tiverem&lt;br&gt;timeout, retry, breaker e monitor por&lt;br&gt;gateway funcionando em homologacao." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1B5E20;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="690" y="945" width="335" height="360" as="geometry" /></mxCell>
        <mxCell id="sep" value="" style="endArrow=none;dashed=1;html=1;strokeWidth=3;strokeColor=#C7131F;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1075" y="880" as="sourcePoint" /><mxPoint x="1075" y="1335" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="sepLbl" value="FRONTEIRA&lt;br&gt;DE ESCOPO" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=10;fontColor=#C7131F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1035" y="1090" width="80" height="60" as="geometry" /></mxCell>
        <mxCell id="futuro" value="FASES 2 e 3 - NAO CONSTRUIR AGORA  (mesmo blueprint da Fase 1, so muda a imagem, o DD_SERVICE e o target group)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#879196;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontColor=#879196;fontSize=12;fontStyle=1;dashed=1;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1120" y="895" width="830" height="430" as="geometry" /></mxCell>
        <mxCell id="cdbSvc" value="FASE 2 - cdb&lt;br&gt;&lt;br&gt;- target group: tg-cdb&lt;br&gt;- rota: /cdb/*&lt;br&gt;- reaproveita a MESMA lib&lt;br&gt;  provider-clients&lt;br&gt;- pode usar os mesmos&lt;br&gt;  gateways, mudando so&lt;br&gt;  os paths&lt;br&gt;- deploy e escala&lt;br&gt;  independentes de fundos" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontColor=#545B64;fontSize=11;fontStyle=0;dashed=1;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1145" y="950" width="380" height="355" as="geometry" /></mxCell>
        <mxCell id="rfSvc" value="FASE 3 - renda-fixa&lt;br&gt;&lt;br&gt;- target group: tg-renda-fixa&lt;br&gt;- rota: /renda-fixa/*&lt;br&gt;- mesma lib e mesmo&lt;br&gt;  padrao de task&lt;br&gt;- avaliar se precisa de&lt;br&gt;  gateway novo ou se&lt;br&gt;  reusa os 4 existentes&lt;br&gt;- so comecar apos a&lt;br&gt;  Fase 2 estar estavel" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontColor=#545B64;fontSize=11;fontStyle=0;dashed=1;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1545" y="950" width="380" height="355" as="geometry" /></mxCell>
        <mxCell id="ssm" value="Parameter Store&lt;br&gt;base-url + paths" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientDirection=north;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.systems_manager;gradientColor=#F34482;fillColor=#BC1356;" vertex="1" parent="1"><mxGeometry x="400" y="1405" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="secrets" value="Secrets Manager&lt;br&gt;credencial por gateway" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientDirection=north;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;gradientColor=#F54749;fillColor=#C7131F;" vertex="1" parent="1"><mxGeometry x="580" y="1405" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="pca" value="ACM Private CA&lt;br&gt;mTLS" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientDirection=north;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.certificate_manager;gradientColor=#F54749;fillColor=#C7131F;" vertex="1" parent="1"><mxGeometry x="770" y="1405" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="appcfg" value="AppConfig&lt;br&gt;flag por gateway" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientDirection=north;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.appconfig;gradientColor=#F34482;fillColor=#BC1356;" vertex="1" parent="1"><mxGeometry x="930" y="1405" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="s3" value="S3 Object Lock&lt;br&gt;(auditoria, opcional)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientDirection=north;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;gradientColor=#60A337;fillColor=#277116;opacity=60;" vertex="1" parent="1"><mxGeometry x="1110" y="1405" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="c6n" value="Trocar a URL de homologacao de um provedor deve ser mudanca de PARAMETRO, nao build + deploy.&lt;br&gt;O mesmo artefato sobe em dev, hml e prd - o que muda e o prefixo /investimentos/{env}/gateways/...&lt;br&gt;A feature flag por gateway permite desligar um provedor em incidente sem subir versao." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#6B2FD6;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1280" y="1400" width="670" height="120" as="geometry" /></mxCell>
        <mxCell id="nat" value="NAT Gateway&lt;br&gt;+ Elastic IP fixo" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientDirection=north;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.nat_gateway;gradientColor=#945DF2;fillColor=#5A30B5;" vertex="1" parent="1"><mxGeometry x="400" y="1595" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="igw" value="Internet Gateway" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientDirection=north;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.internet_gateway;gradientColor=#945DF2;fillColor=#5A30B5;" vertex="1" parent="1"><mxGeometry x="560" y="1595" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="c7n" value="Um unico IP de saida (EIP) para informar na allowlist de TODOS os gateways da camada 8.&lt;br&gt;Se um provedor exigir IP dedicado por ambiente, use um NAT por conta (dev / hml / prd) - o EIP muda, o desenho nao.&lt;br&gt;mTLS client-side sai daqui: certificado carregado do Secrets Manager em runtime, nunca embutido na imagem." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5C7D0F;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="720" y="1590" width="1230" height="130" as="geometry" /></mxCell>

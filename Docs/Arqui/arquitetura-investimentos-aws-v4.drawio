        <mxCell id="cachepolr7c3" value="-" style="shape=partialRectangle;connectable=0;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;spacingRight=4;overflow=hidden;html=1;whiteSpace=wrap;fontSize=11;fillColor=none;fontColor=#545B64;" vertex="1" parent="cachepolr7"><mxGeometry x="710" width="240" height="28" as="geometry"><mxRectangle width="240" height="28" as="alternateBounds" /></mxGeometry></mxCell>

        <mxCell id="t1" value="Arquitetura em camadas - Fase 1: FUNDOS | Fases 2 e 3: CDB e Renda Fixa (fora do escopo agora)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="2000" height="34" as="geometry" /></mxCell>
        <mxCell id="t1b" value="Cada camada e independente: da para construir, testar e observar uma de cada vez. As setas mostram a unica direcao de trafego permitida." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#545B64;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="66" width="2000" height="26" as="geometry" /></mxCell>

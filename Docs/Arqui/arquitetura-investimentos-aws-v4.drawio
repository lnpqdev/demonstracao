        <mxCell id="gwn4" value="+ demais endpoints e config completa na pagina 2" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=9;fontColor=#545B64;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1595" y="2290" width="360" height="30" as="geometry" /></mxCell>
        <mxCell id="c8n" value="O gateway e a unidade de isolamento: a cota de 429 e compartilhada por todos os endpoints daquele host. Por isso 1 pool, 1 bulkhead e 1 circuit breaker POR GATEWAY - e timeout por endpoint." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#8B0F18;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="320" y="2410" width="1660" height="44" as="geometry" /></mxCell>
        <mxCell id="cicd" value="CI/CD e Artefatos" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F8FF;strokeColor=#3334B9;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontColor=#3334B9;fontSize=12;fontStyle=1;dashed=0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="2010" y="510" width="270" height="830" as="geometry" /></mxCell>
        <mxCell id="cart" value="CodeArtifact" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientDirection=north;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.codeartifact;gradientColor=#4D72F3;fillColor=#3334B9;" vertex="1" parent="1"><mxGeometry x="2115" y="560" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="ecr" value="ECR" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientDirection=north;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecr;gradientColor=#F78E04;fillColor=#D05C17;" vertex="1" parent="1"><mxGeometry x="2115" y="680" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="cbuild" value="CodeBuild" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientDirection=north;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.codebuild;gradientColor=#4D72F3;fillColor=#3334B9;" vertex="1" parent="1"><mxGeometry x="2115" y="800" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="cicdn" value="lib provider-clients:&lt;br&gt;JAR versionado (semver)&lt;br&gt;so com transporte -&lt;br&gt;um HTTP client por&lt;br&gt;GATEWAY, mTLS, timeout,&lt;br&gt;retry com jitter, 429 /&lt;br&gt;Retry-After, breaker e&lt;br&gt;bulkhead.&lt;br&gt;&lt;br&gt;A URL e os paths nao&lt;br&gt;sao compilados: vem da&lt;br&gt;camada 6 no boot.&lt;br&gt;&lt;br&gt;A traducao para o dominio&lt;br&gt;(ACL) fica dentro de cada&lt;br&gt;servico da camada 5." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#3334B9;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="2025" y="890" width="245" height="430" as="geometry" /></mxCell>
        <mxCell id="ddBox" value="Datadog (SaaS) - observabilidade de TODAS as camadas" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#632CA6;verticalAlign=top;align=center;spacingTop=8;fontColor=#632CA6;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2340" y="310" width="420" height="1030" as="geometry" /></mxCell>
        <mxCell id="ddText" value="Camada 1 - RUM (app e web)&lt;br&gt;&lt;br&gt;Camada 2 - metricas do API Gateway&lt;br&gt;via AWS Integration + Synthetics no&lt;br&gt;endpoint publico&lt;br&gt;&lt;br&gt;Camada 3 e 5 - APM com dd-java-agent,&lt;br&gt;trace unico propagado ponta a ponta&lt;br&gt;&lt;br&gt;Camada 5 - metricas custom DogStatsD:&lt;br&gt;hit ratio do Caffeine, estado do&lt;br&gt;circuit breaker, saturacao do pool&lt;br&gt;&lt;br&gt;Camada 7 - trafego do NAT&lt;br&gt;&lt;br&gt;Camada 8 - span de saida com tag&lt;br&gt;gateway + operation + provider,&lt;br&gt;taxa de 429 por gateway e 1 teste&lt;br&gt;Synthetics por gateway&lt;br&gt;&lt;br&gt;Tags obrigatorias:&lt;br&gt;DD_ENV / DD_SERVICE / DD_VERSION&lt;br&gt;&lt;br&gt;Sem DBM: nao ha banco de dados.&lt;br&gt;&lt;br&gt;Regra pratica: como o servico e&lt;br&gt;stateless, quase toda falha nasce&lt;br&gt;na camada 8 - o alerta precisa&lt;br&gt;apontar o gateway culpado." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#432466;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="2360" y="350" width="385" height="970" as="geometry" /></mxCell>
        <mxCell id="x1" value="HTTPS publico" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#232F3E;strokeWidth=2;" edge="1" parent="1" source="clients" target="apigw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="x2" value="VPC Link (privado)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#BC1356;strokeWidth=2;" edge="1" parent="1" source="apigw" target="bff"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="x3" value="HTTPS interno + JWT propagado (SG-to-SG)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#5A30B5;strokeWidth=2;" edge="1" parent="1" source="bff" target="alb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>

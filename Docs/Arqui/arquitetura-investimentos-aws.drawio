        <mxCell id="e9" value="saida HTTPS / mTLS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#3334B9;strokeWidth=2;" edge="1" parent="1" source="libBox" target="nat">
          <mxGeometry relative="1" as="geometry" />

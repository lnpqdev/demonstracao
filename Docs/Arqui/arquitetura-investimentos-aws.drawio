        <mxCell id="cicdText" value="lib provider-clients publicada como JAR versionado (semver).&lt;br&gt;Contem SOMENTE transporte: client HTTP por provedor, SSLContext mTLS,&lt;br&gt;timeouts, retry/backoff, circuit breaker e instrumentacao.&lt;br&gt;&lt;br&gt;A traducao para o dominio (ACL) fica DENTRO de cada servico -&lt;br&gt;assim fundos, cdb e renda-fixa evoluem sem acoplamento de deploy." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="1810" y="540" width="365" height="150" as="geometry" />
        </mxCell>

        <mxCell id="cw" value="CloudWatch" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=#F34482;gradientDirection=north;fillColor=#BC1356;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="1">
          <mxGeometry x="1830" y="790" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cwText" value="Container Insights, metricas de ALB,&lt;br&gt;Aurora, SQS, EventBridge e API Gateway.&lt;br&gt;&lt;br&gt;Coletadas pela AWS Integration do Datadog&lt;br&gt;(role IAM cross-account read-only).&lt;br&gt;CloudWatch continua como fonte de&lt;br&gt;metricas gerenciadas; o Datadog e o painel unico." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="1910" y="785" width="270" height="160" as="geometry" />
        </mxCell>

        <mxCell id="secNote" value="Sem IP publico nas tasks | Comunicacao autorizada por Security Group (SG do BFF -&gt; SG do ALB -&gt; SG dos servicos) | Saida somente via NAT com EIP fixo (allowlist dos provedores)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#8C4FFF;" vertex="1" parent="1">
          <mxGeometry x="370" y="1490" width="1340" height="40" as="geometry" />
        </mxCell>
        <mxCell id="acctNote" value="Multi-conta (Control Tower): esta VPC representa a conta de workload (dev / hml / prd). Contas de seguranca e de rede/CI-CD ficam separadas. Se o BFF viver em OUTRA conta, ver pagina 2 - Opcao C." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#147EBA;" vertex="1" parent="1">
          <mxGeometry x="330" y="1555" width="1420" height="40" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#232F3E;" edge="1" parent="1" source="clients" target="r53">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#232F3E;" edge="1" parent="1" source="r53" target="waf">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#232F3E;" edge="1" parent="1" source="waf" target="apigw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3b" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#C7131F;dashed=1;" edge="1" parent="1" source="cognito" target="apigw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="VPC Link (privado)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#BC1356;strokeWidth=2;" edge="1" parent="1" source="apigw" target="bff">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="HTTPS interno + JWT propagado&lt;br&gt;(SG-to-SG, sem gateway proprio)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#5A30B5;strokeWidth=2;" edge="1" parent="1" source="bff" target="alb">
          <mxGeometry relative="1" as="geometry" />

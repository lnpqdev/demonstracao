        <mxCell id="e6" value="/fundos/*" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#5A30B5;strokeWidth=2;" edge="1" parent="1" source="alb" target="fundosSvc">
          <mxGeometry relative="1" as="geometry" />

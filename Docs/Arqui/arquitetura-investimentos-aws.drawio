        <mxCell id="e20" value="imagem" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#D05C17;dashed=1;" edge="1" parent="1" source="ecr" target="ecsCluster">

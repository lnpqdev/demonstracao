        <mxCell id="riskr1c0" value="Cota de 429 por gateway" style="shape=partialRectangle;connectable=0;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;spacingRight=4;overflow=hidden;html=1;whiteSpace=wrap;fontSize=11;fillColor=none;fontColor=#545B64;" vertex="1" parent="riskr1"><mxGeometry x="0" width="300" height="30" as="geometry"><mxRectangle width="300" height="30" as="alternateBounds" /></mxGeometry></mxCell>
        <mxCell id="riskr1c1" value="A cota e do host. Tres servicos escalando em paralelo estouram o limite do provedor sem que nenhum deles perceba sozinho." style="shape=partialRectangle;connectable=0;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;spacingRight=4;overflow=hidden;html=1;whiteSpace=wrap;fontSize=11;fillColor=none;fontColor=#545B64;" vertex="1" parent="riskr1"><mxGeometry x="300" width="560" height="30" as="geometry"><mxRectangle width="560" height="30" as="alternateBounds" /></mxGeometry></mxCell>
        <mxCell id="riskr1c2" value="Token bucket compartilhado no Valkey, com cota por gateway dividida por produto. Alertar quando qualquer produto passar da sua fatia." style="shape=partialRectangle;connectable=0;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;spacingRight=4;overflow=hidden;html=1;whiteSpace=wrap;fontSize=11;fillColor=none;fontColor=#545B64;" vertex="1" parent="riskr1"><mxGeometry x="860" width="560" height="30" as="geometry"><mxRectangle width="560" height="30" as="alternateBounds" /></mxGeometry></mxCell>
        <mxCell id="riskr2" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;" vertex="1" parent="risk"><mxGeometry y="90" width="1420" height="30" as="geometry" /></mxCell>
        <mxCell id="riskr2c0" value="Versao da lib" style="shape=partialRectangle;connectable=0;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;spacingRight=4;overflow=hidden;html=1;whiteSpace=wrap;fontSize=11;fillColor=none;fontColor=#545B64;" vertex="1" parent="riskr2"><mxGeometry x="0" width="300" height="30" as="geometry"><mxRectangle width="300" height="30" as="alternateBounds" /></mxGeometry></mxCell>
        <mxCell id="riskr2c1" value="Cada servico pode subir numa versao diferente de provider-clients e reagir diferente ao mesmo provedor." style="shape=partialRectangle;connectable=0;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;spacingRight=4;overflow=hidden;html=1;whiteSpace=wrap;fontSize=11;fillColor=none;fontColor=#545B64;" vertex="1" parent="riskr2"><mxGeometry x="300" width="560" height="30" as="geometry"><mxRectangle width="560" height="30" as="alternateBounds" /></mxGeometry></mxCell>
        <mxCell id="riskr2c2" value="Fixar a versao nos tres poms e subir junto. Tratar upgrade de lib como mudanca coordenada, com a versao como tag no Datadog." style="shape=partialRectangle;connectable=0;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;spacingRight=4;overflow=hidden;html=1;whiteSpace=wrap;fontSize=11;fillColor=none;fontColor=#545B64;" vertex="1" parent="riskr2"><mxGeometry x="860" width="560" height="30" as="geometry"><mxRectangle width="560" height="30" as="alternateBounds" /></mxGeometry></mxCell>
        <mxCell id="riskr3" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;" vertex="1" parent="risk"><mxGeometry y="120" width="1420" height="30" as="geometry" /></mxCell>
        <mxCell id="riskr3c0" value="Compromissadas tem mais estado" style="shape=partialRectangle;connectable=0;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;spacingRight=4;overflow=hidden;html=1;whiteSpace=wrap;fontSize=11;fillColor=none;fontColor=#545B64;" vertex="1" parent="riskr3"><mxGeometry x="0" width="300" height="30" as="geometry"><mxRectangle width="300" height="30" as="alternateBounds" /></mxGeometry></mxCell>
        <mxCell id="riskr3c1" value="Lastro, contraparte e recompra tem ciclo que atravessa o dia. Consultar o gateway a cada requisicao pode nao bastar para conciliacao e prova." style="shape=partialRectangle;connectable=0;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;spacingRight=4;overflow=hidden;html=1;whiteSpace=wrap;fontSize=11;fillColor=none;fontColor=#545B64;" vertex="1" parent="riskr3"><mxGeometry x="300" width="560" height="30" as="geometry"><mxRectangle width="560" height="30" as="alternateBounds" /></mxGeometry></mxCell>
        <mxCell id="riskr3c2" value="Reavaliar a premissa stateless SO para este contexto. Se precisar, comece pelo minimo: S3 com Object Lock para trilha, e so depois discuta banco." style="shape=partialRectangle;connectable=0;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;spacingRight=4;overflow=hidden;html=1;whiteSpace=wrap;fontSize=11;fillColor=none;fontColor=#545B64;" vertex="1" parent="riskr3"><mxGeometry x="860" width="560" height="30" as="geometry"><mxRectangle width="560" height="30" as="alternateBounds" /></mxGeometry></mxCell>
        <mxCell id="riskr4" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;" vertex="1" parent="risk"><mxGeometry y="150" width="1420" height="30" as="geometry" /></mxCell>
        <mxCell id="riskr4c0" value="Ordem de implantacao" style="shape=partialRectangle;connectable=0;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;spacingRight=4;overflow=hidden;html=1;whiteSpace=wrap;fontSize=11;fillColor=none;fontColor=#545B64;" vertex="1" parent="riskr4"><mxGeometry x="0" width="300" height="30" as="geometry"><mxRectangle width="300" height="30" as="alternateBounds" /></mxGeometry></mxCell>
        <mxCell id="riskr4c1" value="Subir CDB e Compromissadas juntos dobra o risco e mistura as causas de qualquer incidente." style="shape=partialRectangle;connectable=0;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;spacingRight=4;overflow=hidden;html=1;whiteSpace=wrap;fontSize=11;fillColor=none;fontColor=#545B64;" vertex="1" parent="riskr4"><mxGeometry x="300" width="560" height="30" as="geometry"><mxRectangle width="560" height="30" as="alternateBounds" /></mxGeometry></mxCell>
        <mxCell id="riskr4c2" value="CDB primeiro (mais parecido com fundos), estabilizar por um ciclo, depois Compromissadas. Escopo fechado por vez, como na fase 1." style="shape=partialRectangle;connectable=0;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;spacingRight=4;overflow=hidden;html=1;whiteSpace=wrap;fontSize=11;fillColor=none;fontColor=#545B64;" vertex="1" parent="riskr4"><mxGeometry x="860" width="560" height="30" as="geometry"><mxRectangle width="560" height="30" as="alternateBounds" /></mxGeometry></mxCell>
        <mxCell id="riskr5" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;" vertex="1" parent="risk"><mxGeometry y="180" width="1420" height="30" as="geometry" /></mxCell>
        <mxCell id="riskr5c0" value="Isolamento de falha" style="shape=partialRectangle;connectable=0;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;spacingRight=4;overflow=hidden;html=1;whiteSpace=wrap;fontSize=11;fillColor=none;fontColor=#545B64;" vertex="1" parent="riskr5"><mxGeometry x="0" width="300" height="30" as="geometry"><mxRectangle width="300" height="30" as="alternateBounds" /></mxGeometry></mxCell>
        <mxCell id="riskr5c1" value="Um breaker aberto no gateway 2 afeta os tres produtos ao mesmo tempo." style="shape=partialRectangle;connectable=0;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;spacingRight=4;overflow=hidden;html=1;whiteSpace=wrap;fontSize=11;fillColor=none;fontColor=#545B64;" vertex="1" parent="riskr5"><mxGeometry x="300" width="560" height="30" as="geometry"><mxRectangle width="560" height="30" as="alternateBounds" /></mxGeometry></mxCell>
        <mxCell id="riskr5c2" value="Bulkhead por gateway E por servico. Feature flag no AppConfig por produto, para degradar um sem derrubar os outros." style="shape=partialRectangle;connectable=0;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;spacingRight=4;overflow=hidden;html=1;whiteSpace=wrap;fontSize=11;fillColor=none;fontColor=#545B64;" vertex="1" parent="riskr5"><mxGeometry x="860" width="560" height="30" as="geometry"><mxRectangle width="560" height="30" as="alternateBounds" /></mxGeometry></mxCell>
        <mxCell id="riskr6" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;" vertex="1" parent="risk"><mxGeometry y="210" width="1420" height="30" as="geometry" /></mxCell>
        <mxCell id="riskr6c0" value="Custo" style="shape=partialRectangle;connectable=0;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;spacingRight=4;overflow=hidden;html=1;whiteSpace=wrap;fontSize=11;fillColor=none;fontColor=#545B64;" vertex="1" parent="riskr6"><mxGeometry x="0" width="300" height="30" as="geometry"><mxRectangle width="300" height="30" as="alternateBounds" /></mxGeometry></mxCell>
        <mxCell id="riskr6c1" value="Tres servicos com 2 tasks minimas cada = 6 tasks sempre ligadas, mais 3 sidecars de Datadog." style="shape=partialRectangle;connectable=0;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;spacingRight=4;overflow=hidden;html=1;whiteSpace=wrap;fontSize=11;fillColor=none;fontColor=#545B64;" vertex="1" parent="riskr6"><mxGeometry x="300" width="560" height="30" as="geometry"><mxRectangle width="560" height="30" as="alternateBounds" /></mxGeometry></mxCell>
        <mxCell id="riskr6c2" value="FARGATE_SPOT em dev e hml. Revisar desiredCount minimo por produto - nem todos precisam de 2 em homologacao." style="shape=partialRectangle;connectable=0;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;spacingRight=4;overflow=hidden;html=1;whiteSpace=wrap;fontSize=11;fillColor=none;fontColor=#545B64;" vertex="1" parent="riskr6"><mxGeometry x="860" width="560" height="30" as="geometry"><mxRectangle width="560" height="30" as="alternateBounds" /></mxGeometry></mxCell>
        <mxCell id="riskr7" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;" vertex="1" parent="risk"><mxGeometry y="240" width="1420" height="30" as="geometry" /></mxCell>
        <mxCell id="riskr7c0" value="Onde NAO mexer" style="shape=partialRectangle;connectable=0;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;spacingRight=4;overflow=hidden;html=1;whiteSpace=wrap;fontSize=11;fillColor=none;fontColor=#545B64;" vertex="1" parent="riskr7"><mxGeometry x="0" width="300" height="30" as="geometry"><mxRectangle width="300" height="30" as="alternateBounds" /></mxGeometry></mxCell>
        <mxCell id="riskr7c1" value="A tentacao e criar cluster, ALB ou conta por produto." style="shape=partialRectangle;connectable=0;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;spacingRight=4;overflow=hidden;html=1;whiteSpace=wrap;fontSize=11;fillColor=none;fontColor=#545B64;" vertex="1" parent="riskr7"><mxGeometry x="300" width="560" height="30" as="geometry"><mxRectangle width="560" height="30" as="alternateBounds" /></mxGeometry></mxCell>
        <mxCell id="riskr7c2" value="Nao. O isolamento util vem de Service, SG e Task Role separados - que voce ja tem. O resto so multiplica custo e configuracao." style="shape=partialRectangle;connectable=0;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;spacingRight=4;overflow=hidden;html=1;whiteSpace=wrap;fontSize=11;fillColor=none;fontColor=#545B64;" vertex="1" parent="riskr7"><mxGeometry x="860" width="560" height="30" as="geometry"><mxRectangle width="560" height="30" as="alternateBounds" /></mxGeometry></mxCell>
        <mxCell id="rn" value="Sequencia recomendada: 1) subir o controle de vazao compartilhado ainda com fundos sozinho, para validar sem risco. 2) CDB. 3) estabilizar. 4) Compromissadas, ja com a decisao de estado fechada." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#8B0F18;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="1380" height="44" as="geometry" /></mxCell>

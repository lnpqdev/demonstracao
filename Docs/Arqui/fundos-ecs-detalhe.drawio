<mxfile host="app.diagrams.net" agent="Claude" version="24.0.0" type="device">
  <diagram id="fa1" name="1 - Fundos: objetos criados no ECS">
    <mxGraphModel dx="1800" dy="1100" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="Servico FUNDOS - o que exatamente e criado no ECS" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2000" height="34" as="geometry" /></mxCell>
        <mxCell id="t2" value="Numerado na ordem real de criacao. Ambar = recurso COMPARTILHADO (criado uma vez, serve as tres fases). Verde = recurso PROPRIO do servico fundos (replicado por servico nas fases seguintes)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#545B64;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="2200" height="26" as="geometry" /></mxCell>
        <mxCell id="b1" value="1.  CLUSTER ECS   -   COMPARTILHADO" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3D6;strokeColor=#B26A00;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontColor=#8A5200;fontSize=13;fontStyle=1;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="2300" height="150" as="geometry" /></mxCell>
        <mxCell id="b1i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientDirection=north;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.elastic_container_service;gradientColor=#F78E04;fillColor=#D05C17;" vertex="1" parent="1"><mxGeometry x="90" y="150" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="b1t" value="Nome: plat-investimentos&lt;br&gt;Capacity providers: FARGATE (padrao) + FARGATE_SPOT (apenas dev e hml)&lt;br&gt;Container Insights: ligado - e daqui que vem CPU, memoria e contagem de task para o Datadog&lt;br&gt;Namespace Service Connect: investimentos.local (criar so quando existir chamada servico-a-servico; na fase 1 nao e necessario)&lt;br&gt;&lt;br&gt;Criado UMA VEZ. As fases 2 e 3 entram neste mesmo cluster - nao crie cluster por produto: isso multiplica configuracao sem isolar nada de verdade,&lt;br&gt;já que o isolamento real vem de Service, Security Group e Task Role separados." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#8A5200;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="190" y="140" width="2100" height="110" as="geometry" /></mxCell>
        <mxCell id="b2" value="2.  SECURITY GROUP   -   PROPRIO DO SERVICO" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6F6E6;strokeColor=#277116;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontColor=#1B5E20;fontSize=13;fontStyle=1;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="740" height="330" as="geometry" /></mxCell>
        <mxCell id="b2t" value="sg-fundos&lt;br&gt;&lt;br&gt;Entrada (inbound)&lt;br&gt;- porta 8080/TCP com origem = sg-alb-interno&lt;br&gt;- NENHUMA outra regra. Sem CIDR, sem 0.0.0.0/0&lt;br&gt;&lt;br&gt;Saida (outbound)&lt;br&gt;- 443/TCP para 0.0.0.0/0 (sai pelo NAT ate os gateways)&lt;br&gt;- 443/TCP para os VPC Endpoints, se voce criar&lt;br&gt;&lt;br&gt;Por que proprio: e o que garante que, na fase 2,&lt;br&gt;um incidente no servico de CDB nao alcance o de&lt;br&gt;fundos pela rede. Um SG compartilhado apagaria&lt;br&gt;essa fronteira." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1B5E20;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="700" height="280" as="geometry" /></mxCell>
        <mxCell id="b3" value="3.  IAM - DUAS ROLES DIFERENTES" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7131F;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontColor=#8B0F18;fontSize=13;fontStyle=1;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="830" y="290" width="740" height="330" as="geometry" /></mxCell>
        <mxCell id="b3t" value="ecs-execution-role   -   COMPARTILHADO&lt;br&gt;Usada pelo agente do ECS, nao pela aplicacao.&lt;br&gt;- pull da imagem no ECR&lt;br&gt;- leitura dos secrets no momento do start&lt;br&gt;- escrita no log driver&lt;br&gt;&lt;br&gt;fundos-task-role   -   PROPRIO DO SERVICO&lt;br&gt;Usada pelo codigo Java em runtime.&lt;br&gt;- ssm:GetParameters em /investimentos/{env}/gateways/*&lt;br&gt;- secretsmanager:GetSecretValue apenas dos segredos de fundos&lt;br&gt;- appconfig:GetLatestConfiguration&lt;br&gt;&lt;br&gt;Nao junte as duas. A execution role e da plataforma;&lt;br&gt;a task role e do produto - e na fase 2 cada servico&lt;br&gt;precisa da sua, com escopo so dos seus parametros." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#8B0F18;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="850" y="330" width="700" height="280" as="geometry" /></mxCell>
        <mxCell id="b4" value="4.  TARGET GROUP + REGRA NO ALB   -   PROPRIO" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6F6E6;strokeColor=#277116;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontColor=#1B5E20;fontSize=13;fontStyle=1;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1620" y="290" width="740" height="330" as="geometry" /></mxCell>
        <mxCell id="b4t" value="tg-fundos&lt;br&gt;- target type: ip  (obrigatorio em awsvpc/Fargate)&lt;br&gt;- protocolo/porta: HTTP 8080&lt;br&gt;- health check: GET /actuator/health&lt;br&gt;- healthy threshold 2 / unhealthy 3 / intervalo 15s&lt;br&gt;- deregistration delay: 30s (o padrao de 300s deixa&lt;br&gt;  deploy lento sem necessidade)&lt;br&gt;&lt;br&gt;Regra no listener do ALB interno&lt;br&gt;- prioridade 10&lt;br&gt;- condicao: path /fundos/*&lt;br&gt;- acao: forward para tg-fundos&lt;br&gt;&lt;br&gt;Crie ANTES do service: o service referencia o target&lt;br&gt;group na criacao e nao aceita associacao depois." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1B5E20;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1640" y="330" width="700" height="280" as="geometry" /></mxCell>
        <mxCell id="b5" value="5.  TASK DEFINITION   -   PROPRIA (familia fundos)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6F6E6;strokeColor=#277116;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontColor=#1B5E20;fontSize=13;fontStyle=1;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="740" height="470" as="geometry" /></mxCell>
        <mxCell id="b5t" value="Familia: fundos   |   Revisao: nova a cada deploy (fundos:12, fundos:13...)&lt;br&gt;&lt;br&gt;Nivel da task&lt;br&gt;- CPU 1024 / Memoria 2048 (comece aqui e ajuste pelo heap do Caffeine)&lt;br&gt;- networkMode: awsvpc&lt;br&gt;- executionRoleArn: ecs-execution-role&lt;br&gt;- taskRoleArn: fundos-task-role&lt;br&gt;- volume: dd-agent-vol (compartilhado entre init e app)&lt;br&gt;&lt;br&gt;Containers (4)&lt;br&gt;1. dd-java-agent-init  -  essential=false, copia o jar no volume&lt;br&gt;2. app                 -  essential=TRUE, porta 8080, imagem do ECR,&lt;br&gt;                          dependsOn: init com condition COMPLETE&lt;br&gt;3. datadog-agent       -  essential=false, sidecar de APM e DogStatsD&lt;br&gt;4. log-router          -  FireLens, tipo fluentbit, output datadog&lt;br&gt;&lt;br&gt;Secrets do container (nao env comum)&lt;br&gt;- DD_API_KEY  -&gt;  arn do secret no Secrets Manager&lt;br&gt;&lt;br&gt;A revisao e imutavel: mudou variavel, mudou imagem, mudou CPU = revisao nova.&lt;br&gt;E o que permite rollback deterministico - voltar e apontar a revisao anterior." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1B5E20;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="60" y="690" width="700" height="420" as="geometry" /></mxCell>
        <mxCell id="b6" value="6.  ECS SERVICE   -   PROPRIO" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6F6E6;strokeColor=#277116;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontColor=#1B5E20;fontSize=13;fontStyle=1;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="830" y="650" width="740" height="470" as="geometry" /></mxCell>
        <mxCell id="b6t" value="Nome: fundos   |   Cluster: plat-investimentos   |   launchType: FARGATE&lt;br&gt;&lt;br&gt;Rede&lt;br&gt;- subnets: as duas subnets privadas de aplicacao (2 AZs)&lt;br&gt;- securityGroups: sg-fundos&lt;br&gt;- assignPublicIp: DISABLED   &lt;- confirme, o padrao do console e ENABLED&lt;br&gt;&lt;br&gt;Load balancer&lt;br&gt;- targetGroupArn: tg-fundos | containerName: app | containerPort: 8080&lt;br&gt;- healthCheckGracePeriod: 60s (tempo de subida da JVM antes de contar falha)&lt;br&gt;&lt;br&gt;Capacidade e deploy&lt;br&gt;- desiredCount: 2 (uma task por AZ - nunca 1 em producao)&lt;br&gt;- minimumHealthyPercent: 100 / maximumPercent: 200 (rolling sem degradar)&lt;br&gt;- deploymentCircuitBreaker: enable=true, rollback=true&lt;br&gt;- deploymentController: ECS (rolling) ou CODE_DEPLOY (blue/green)&lt;br&gt;&lt;br&gt;O service e o objeto que RECONCILIA: ele mantem desiredCount tasks vivas,&lt;br&gt;substitui as que falham no health check e executa o deploy. A task definition&lt;br&gt;sozinha nao roda nada." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1B5E20;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="850" y="690" width="700" height="420" as="geometry" /></mxCell>
        <mxCell id="b7" value="7.  TASKS EM EXECUCAO   -   consequencia, nao recurso" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#879196;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontColor=#545B64;fontSize=13;fontStyle=1;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1620" y="650" width="740" height="470" as="geometry" /></mxCell>
        <mxCell id="b7t" value="O service cria e mantem as tasks. Voce nao cria task na mao em producao.&lt;br&gt;&lt;br&gt;Task 1 - AZ sa-east-1a           Task 2 - AZ sa-east-1b&lt;br&gt;- ENI privada propria            - ENI privada propria&lt;br&gt;- IP da subnet (muda a cada      - IP da subnet&lt;br&gt;  deploy - por isso o target       (por isso target type = ip,&lt;br&gt;  group aponta para IP, nunca      e o registro e automatico)&lt;br&gt;  para nome fixo)&lt;br&gt;- 4 containers rodando           - 4 containers rodando&lt;br&gt;&lt;br&gt;Ciclo de vida no deploy&lt;br&gt;PROVISIONING -&gt; PENDING -&gt; ACTIVATING -&gt; RUNNING -&gt; registro no&lt;br&gt;target group -&gt; health check passa -&gt; a task antiga entra em&lt;br&gt;DEACTIVATING -&gt; deregistration delay -&gt; STOPPED&lt;br&gt;&lt;br&gt;stopTimeout: 30s   -   tempo para o app terminar requisicao em voo.&lt;br&gt;Sem isso, o SIGKILL corta chamada aberta com o gateway do provedor." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#545B64;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1640" y="690" width="700" height="420" as="geometry" /></mxCell>
        <mxCell id="b8" value="8.  AUTO SCALING   -   PROPRIO" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6F6E6;strokeColor=#277116;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontColor=#1B5E20;fontSize=13;fontStyle=1;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1150" width="740" height="320" as="geometry" /></mxCell>
        <mxCell id="b8t" value="Application Auto Scaling (nao e o ASG do EC2)&lt;br&gt;&lt;br&gt;Scalable target&lt;br&gt;- resourceId: service/plat-investimentos/fundos&lt;br&gt;- min 2 / max 10&lt;br&gt;&lt;br&gt;Politica principal - target tracking&lt;br&gt;- ALBRequestCountPerTarget: alvo por task (ajuste com teste de carga)&lt;br&gt;&lt;br&gt;Politica secundaria&lt;br&gt;- CPU media 60%&lt;br&gt;&lt;br&gt;Cuidado especifico do seu caso: escalar task NAO aumenta a cota do&lt;br&gt;gateway do provedor. Mais tasks = mais chamadas concorrentes ao&lt;br&gt;mesmo host = mais 429. Escale olhando fila e latencia do BFF, e&lt;br&gt;mantenha o bulkhead por gateway como teto real." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1B5E20;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="60" y="1190" width="700" height="270" as="geometry" /></mxCell>
        <mxCell id="b9" value="9.  LOGS E OBSERVABILIDADE   -   PROPRIO" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6F6E6;strokeColor=#277116;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontColor=#1B5E20;fontSize=13;fontStyle=1;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="830" y="1150" width="740" height="320" as="geometry" /></mxCell>
        <mxCell id="b9t" value="No container app&lt;br&gt;- logConfiguration.logDriver: awsfirelens&lt;br&gt;- options: Name=datadog, dd_service=fundos, dd_source=java,&lt;br&gt;  dd_tags=env:{env},version:{git-sha}&lt;br&gt;&lt;br&gt;No container datadog-agent&lt;br&gt;- ECS_FARGATE=true, DD_APM_ENABLED=true&lt;br&gt;- DD_APM_NON_LOCAL_TRAFFIC=true&lt;br&gt;- DD_DOGSTATSD_NON_LOCAL_TRAFFIC=true&lt;br&gt;&lt;br&gt;CloudWatch continua recebendo metrica de cluster e service pelo&lt;br&gt;Container Insights - e o Datadog le por AWS Integration.&lt;br&gt;&lt;br&gt;DD_SERVICE=fundos e o que separa este servico dos proximos no painel." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1B5E20;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="850" y="1190" width="700" height="270" as="geometry" /></mxCell>
        <mxCell id="b10" value="10.  CONFIGURACAO EXTERNA   -   prefixo proprio" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6F6E6;strokeColor=#277116;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontColor=#1B5E20;fontSize=13;fontStyle=1;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1620" y="1150" width="740" height="320" as="geometry" /></mxCell>
        <mxCell id="b10t" value="Parameter Store&lt;br&gt;/investimentos/{env}/gateways/{gw}/base-url&lt;br&gt;/investimentos/{env}/gateways/{gw}/paths/{operacao}&lt;br&gt;/investimentos/{env}/gateways/{gw}/timeout-ms/{operacao}&lt;br&gt;&lt;br&gt;Secrets Manager&lt;br&gt;/investimentos/{env}/gateways/{gw}/subscription-key&lt;br&gt;/investimentos/{env}/gateways/{gw}/mtls-cert&lt;br&gt;&lt;br&gt;Na fase 1 os gateways sao lidos so pelo servico de fundos.&lt;br&gt;Na fase 2, CDB e Compromissadas leem os MESMOS parametros de&lt;br&gt;gateway - por isso o prefixo e por gateway, nao por produto.&lt;br&gt;O que e por produto fica em /investimentos/{env}/fundos/..." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1B5E20;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1640" y="1190" width="700" height="270" as="geometry" /></mxCell>
        <mxCell id="e1" value="roles referenciadas na task definition" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#C7131F;dashed=1;" edge="1" parent="1" source="b3" target="b5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e2" value="service aponta para a revisao" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#277116;strokeWidth=2;" edge="1" parent="1" source="b5" target="b6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e3" value="service registra no target group" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#277116;strokeWidth=2;" edge="1" parent="1" source="b4" target="b6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#277116;dashed=1;" edge="1" parent="1" source="b2" target="b6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e5" value="cria e mantem" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#277116;strokeWidth=3;" edge="1" parent="1" source="b6" target="b7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e6" value="ajusta desiredCount" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#277116;dashed=1;" edge="1" parent="1" source="b8" target="b6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="nfoot" value="Regra de ouro para a fase 2: tudo que esta em VERDE se duplica por servico (cdb e compromissadas ganham o seu proprio). Tudo em AMBAR permanece unico. Se voce se pegar duplicando algo ambar, provavelmente esta criando isolamento onde ja existia - e pagando por isso." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#8B0F18;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="1500" width="2300" height="44" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="fa2" name="2 - Ordem de criacao">
    <mxGraphModel dx="1800" dy="1100" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ord" value="Ordem de criacao - do zero ate o servico de fundos no ar" style="shape=table;startSize=30;container=1;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=1;columnLines=1;html=1;whiteSpace=wrap;strokeColor=#232F3E;fontSize=12;fontStyle=1;fontColor=#232F3E;verticalAlign=middle;fillColor=#F7F7F7;strokeColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1530" height="450" as="geometry" /></mxCell>
        <mxCell id="ordr0" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;" vertex="1" parent="ord"><mxGeometry y="30" width="1530" height="28" as="geometry" /></mxCell>
        <mxCell id="ordr0c0" value="#" style="shape=partialRectangle;connectable=0;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;spacingRight=4;overflow=hidden;html=1;whiteSpace=wrap;fontSize=11;fontStyle=1;fillColor=#EFEFEF;fontColor=#232F3E;" vertex="1" parent="ordr0"><mxGeometry x="0" width="50" height="28" as="geometry"><mxRectangle width="50" height="28" as="alternateBounds" /></mxGeometry></mxCell>
        <mxCell id="ordr0c1" value="Recurso" style="shape=partialRectangle;connectable=0;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;spacingRight=4;overflow=hidden;html=1;whiteSpace=wrap;fontSize=11;fontStyle=1;fillColor=#EFEFEF;fontColor=#232F3E;" vertex="1" parent="ordr0"><mxGeometry x="50" width="300" height="28" as="geometry"><mxRectangle width="300" height="28" as="alternateBounds" /></mxGeometry></mxCell>
        <mxCell id="ordr0c2" value="Nome sugerido" style="shape=partialRectangle;connectable=0;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;spacingRight=4;overflow=hidden;html=1;whiteSpace=wrap;fontSize=11;fontStyle=1;fillColor=#EFEFEF;fontColor=#232F3E;" vertex="1" parent="ordr0"><mxGeometry x="350" width="280" height="28" as="geometry"><mxRectangle width="280" height="28" as="alternateBounds" /></mxGeometry></mxCell>
        <mxCell id="ordr0c3" value="Escopo" style="shape=partialRectangle;connectable=0;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;spacingRight=4;overflow=hidden;html=1;whiteSpace=wrap;fontSize=11;fontStyle=1;fillColor=#EFEFEF;fontColor=#232F3E;" vertex="1" parent="ordr0"><mxGeometry x="630" width="190" height="28" as="geometry"><mxRectangle width="190" height="28" as="alternateBounds" /></mxGeometry></mxCell>
        <mxCell id="ordr0c4" value="Depende de" style="shape=partialRectangle;connectable=0;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;spacingRight=4;overflow=hidden;html=1;whiteSpace=wrap;fontSize=11;fontStyle=1;fillColor=#EFEFEF;fontColor=#232F3E;" vertex="1" parent="ordr0"><mxGeometry x="820" width="290" height="28" as="geometry"><mxRectangle width="290" height="28" as="alternateBounds" /></mxGeometry></mxCell>
        <mxCell id="ordr0c5" value="Observacao" style="shape=partialRectangle;connectable=0;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;spacingRight=4;overflow=hidden;html=1;whiteSpace=wrap;fontSize=11;fontStyle=1;fillColor=#EFEFEF;fontColor=#232F3E;" vertex="1" parent="ordr0"><mxGeometry x="1110" width="420" height="28" as="geometry"><mxRectangle width="420" height="28" as="alternateBounds" /></mxGeometry></mxCell>

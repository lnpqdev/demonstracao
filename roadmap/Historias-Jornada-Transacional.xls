<Worksheet ss:Name="Checklist">
<Table><Column ss:AutoFitWidth="0" ss:Width="55"/><Column ss:AutoFitWidth="0" ss:Width="240"/><Column ss:AutoFitWidth="0" ss:Width="130"/><Column ss:AutoFitWidth="0" ss:Width="45"/><Column ss:AutoFitWidth="0" ss:Width="520"/><Column ss:AutoFitWidth="0" ss:Width="100"/><Column ss:AutoFitWidth="0" ss:Width="240"/>
<Row ss:Height="30"><Cell ss:StyleID="head"><Data ss:Type="String">ID</Data></Cell><Cell ss:StyleID="head"><Data ss:Type="String">História</Data></Cell><Cell ss:StyleID="head"><Data ss:Type="String">Tipo</Data></Cell><Cell ss:StyleID="head"><Data ss:Type="String">#</Data></Cell><Cell ss:StyleID="head"><Data ss:Type="String">Item</Data></Cell><Cell ss:StyleID="head"><Data ss:Type="String">Situação</Data></Cell><Cell ss:StyleID="head"><Data ss:Type="String">Observação</Data></Cell></Row>
<Row><Cell><Data ss:Type="String">HU-01</Data></Cell><Cell ss:StyleID="wrap"><Data ss:Type="String">Conta AWS e padrões de nomenclatura</Data></Cell><Cell><Data ss:Type="String">Critério de aceite</Data></Cell><Cell ss:StyleID="num"><Data ss:Type="Number">1</Data></Cell><Cell ss:StyleID="wrap"><Data ss:Type="String">A conta YB3 está criada e com acessos concedidos aos perfis do squad</Data></Cell><Cell ss:StyleID="status"><Data ss:Type="String">Pendente</Data></Cell><Cell><Data ss:Type="String"></Data></Cell></Row><Row><Cell><Data ss:Type="String">HU-01</Data></Cell><Cell ss:StyleID="wrap"><Data ss:Type="String">Conta AWS e padrões de nomenclatura</Data></Cell><Cell><Data ss:Type="String">Critério de aceite</Data></Cell><Cell ss:StyleID="num"><Data ss:Type="Number">2</Data></Cell><Cell ss:StyleID="wrap"><Data ss:Type="String">O documento de padrão de nomes cobre gateways, containers, repositórios, segredos e buckets</Data></Cell><Cell ss:StyleID="status"><Data ss:Type="String">Pendente</Data></Cell><Cell><Data ss:Type="String"></Data></Cell></Row><Row><Cell><Data ss:Type="String">HU-01</Data></Cell><Cell ss:StyleID="wrap"><Data ss:Type="String">Conta AWS e padrões de nomenclatura</Data></Cell><Cell><Data ss:Type="String">Critério de aceite</Data></Cell><Cell ss:StyleID="num"><Data ss:Type="Number">3</Data></Cell><Cell ss:StyleID="wrap"><Data ss:Type="String">O padrão está aplicado nos primeiros recursos criados</Data></Cell><Cell ss:StyleID="status"><Data ss:Type="String">Pendente</Data></Cell><Cell><Data ss:Type="String"></Data></Cell></Row><Row><Cell><Data ss:Type="String">HU-01</Data></Cell><Cell ss:StyleID="wrap"><Data ss:Type="String">Conta AWS e padrões de nomenclatura</Data></Cell><Cell><Data ss:Type="String">Critério de aceite</Data></Cell><Cell ss:StyleID="num"><Data ss:Type="Number">4</Data></Cell><Cell ss:StyleID="wrap"><Data ss:Type="String">Tags de custo estão definidas e obrigatórias</Data></Cell><Cell ss:StyleID="status"><Data ss:Type="String">Pendent
<Row><Cell><Data ss:Type="String">Bloqueado</Data></Cell><Cell><Data ss:Type="String">Backend · Dev</Data></Cell><Cell><Data ss:Type="String">SRE / Infra</Data></Cell></Row>
<Row><Cell><Data ss:Type="String">Em validação</Data></Cell><Cell><Data ss:Type="String">Frontend · Infra</Data></Cell><Cell><Data ss:Type="String">QA</Data></Cell></Row>
<Row><Cell><Data ss:Type="String">Concluído</Data></Cell><Cell><Data ss:Type="String">Frontend · Dev</Data></Cell><Cell><Data ss:Type="String">Backend + Frontend</Data></Cell></Row>

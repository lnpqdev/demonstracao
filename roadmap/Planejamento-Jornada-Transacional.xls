<Row ss:Height="30"><Cell ss:StyleID="head"><Data ss:Type="String">ID</Data></Cell><Cell ss:StyleID="head"><Data ss:Type="String">Risco</Data></Cell><Cell ss:StyleID="head"><Data ss:Type="String">Impacto</Data></Cell><Cell ss:StyleID="head"><Data ss:Type="String">Probabilidade</Data></Cell><Cell ss:StyleID="head"><Data ss:Type="String">Efeito no plano</Data></Cell><Cell ss:StyleID="head"><Data ss:Type="String">Mitigação</Data></Cell><Cell ss:StyleID="head"><Data ss:Type="String">Responsável</Data></Cell><Cell ss:StyleID="head"><Data ss:Type="String">Situação</Data></Cell></Row>
<Row><Cell><Data ss:Type="String">R-01</Data></Cell><Cell><Data ss:Type="String">Provisionamento da conta AWS YB3</Data></Cell><Cell><Data ss:Type="String">Alto</Data></Cell><Cell><Data ss:Type="String">Alta</Data></Cell><Cell><Data ss:Type="String">Atraso empurra toda a Onda 1</Data></Cell><Cell><Data ss:Type="String">Abrir a solicitação antes do início da Onda 1 e acompanhar semanalmente</Data></Cell><Cell><Data ss:Type="String">SRE / Infra</Data></Cell><Cell><Data ss:Type="String">Aberto</Data></Cell></Row>
<Row><Cell><Data ss:Type="String">R-02</Data></Cell><Cell><Data ss:Type="String">Techspec de tagueamento (time de design)</Data></Cell><Cell><Data ss:Type="String">Médio</Data></Cell><Cell><Data ss:Type="String">Média</Data></Cell><Cell><Data ss:Type="String">O card FE-05 sai da Onda 2</Data></Cell><Cell><Data ss:Type="String">Alinhar prazo na primeira semana; plano B é levar o card para a Onda 3</Data></Cell><Cell><Data ss:Type="String">Frontend</Data></Cell><Cell><Data ss:Type="String">Aberto</Data></Cell></Row>
<Row><Cell><Data ss:Type="String">R-03</Data></Cell><Cell><Data ss:Type="String">Contrato de endpoints não fechado</Data></Cell><Cell><Data ss:Type="String">Alto</Data></Cell><Cell><Data ss:Type="String">Média</Data></Cell><Cell><Data ss:Type="String">Retrabalho na integração entre backend e frontend</Data></Cell><Cell><Data ss:Type="String">Fechar PR-01 antes de qualquer card de desenvolvimento entrar em execução</Data></Cell><Cell><Data ss:Type="String">Backend</Data></Cell><Cell><Data ss:Type="String">Aberto</Data></Cell></Row>
<Row><Cell><Data ss:Type="String">R-04</Data></Cell><Cell><Data ss:Type="String">Janela de pentest</Data></Cell><Cell><Data ss:Type="String">Médio</Data></Cell><Cell><Data ss:Type="String">Média</Data></Cell><Cell><Data ss:Type="String">A fila do time de segurança pode não caber na Onda 3</Data></Cell><Cell><Data ss:Type="String">Reservar a data assim que a Onda 2 começar</Data></Cell><Cell><Data ss:Type="String">QA</Data></Cell><Cell><Data ss:Type="String">Aberto</Data></Cell></Row>
<Row><Cell><Data ss:Type="String">R-05</Data></Cell><Cell><Data ss:Type="String">Composição do squad não confirmada</Data></Cell><Cell><Data ss:Type="String">Alto</Data></Cell><Cell><Data ss:Type="String">Alta</Data></Cell><Cell><Data ss:Type="String">Todo o capacity planejado muda</Data></Cell><Cell><Data ss:Type="String">Confirmar nomes e percentual de alocação antes da Onda 1</Data></Cell><Cell><Data ss:Type="String">Gestão</Data></Cell><Cell><Data ss:Type="String">Aberto</Data></Cell></Row>

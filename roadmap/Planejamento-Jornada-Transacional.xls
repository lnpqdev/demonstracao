<Worksheet ss:Name="Parametros">
<Table><Column ss:AutoFitWidth="0" ss:Width="220"/><Column ss:AutoFitWidth="0" ss:Width="120"/><Column ss:AutoFitWidth="0" ss:Width="520"/>
<Row ss:Height="30"><Cell ss:StyleID="head"><Data ss:Type="String">Parâmetro</Data></Cell><Cell ss:StyleID="head"><Data ss:Type="String">Valor</Data></Cell><Cell ss:StyleID="head"><Data ss:Type="String">Observação</Data></Cell></Row>
<Row><Cell ss:StyleID="key"><Data ss:Type="String">Horas por ponto</Data></Cell><Cell><Data ss:Type="Number">2</Data></Cell><Cell ss:StyleID="wrap"><Data ss:Type="String">Referência definida no planejamento; recalibrar após a Onda 1</Data></Cell></Row>
<Row><Cell ss:StyleID="key"><Data ss:Type="String">Dias úteis por onda</Data></Cell><Cell><Data ss:Type="Number">15</Data></Cell><Cell ss:StyleID="wrap"><Data ss:Type="String">Onda de 3 semanas</Data></Cell></Row>
<Row><Cell ss:StyleID="key"><Data ss:Type="String">Horas produtivas por dia</Data></Cell><Cell><Data ss:Type="Number">6</Data></Cell><Cell ss:StyleID="wrap"><Data ss:Type="String">Descontadas cerimônias e suporte</Data></Cell></Row>
<Row><Cell ss:StyleID="key"><Data ss:Type="String">Pessoas no squad</Data></Cell><Cell><Data ss:Type="Number">5</Data></Cell><Cell ss:StyleID="wrap"><Data ss:Type="String">2 backend, 1 frontend, 1 SRE/infra, 1 QA — a confirmar</Data></Cell></Row>
<Row><Cell ss:StyleID="key"><Data ss:Type="String">Capacidade por pessoa / onda</Data></Cell><Cell ss:Formula="=R3C2*R4C2" ss:StyleID="num"><Data ss:Type="Number">0</Data></Cell><Cell ss:StyleID="wrap"><Data ss:Type="String">horas</Data></Cell></Row>
<Row><Cell ss:StyleID="key"><Data ss:Type="String">Capacidade do squad / onda</Data></Cell><Cell ss:Formula="=R6C2*R5C2" ss:StyleID="num"><Data ss:Type="Number">0</Data></Cell><Cell ss:StyleID="wrap"><Data ss:Type="String">horas</Data></Cell></Row>
<Row><Cell ss:StyleID="key"><Data ss:Type="String">Duração total</Data></Cell><Cell><Data ss:Type="String">9 semanas</Data></Cell><Cell ss:StyleID="wrap"><Data ss:Type="String">3 ondas de 3 semanas</Data></Cell></Row>
<Row></Row>
<Row><Cell ss:StyleID="sub"><Data ss:Type="String">Alterar &quot;Horas por ponto&quot; recalcula automaticamente Cronograma, Planning Poker, Capacity e Roadmap.</Data></Cell></Row>
<Row></Row>
<Row ss:Height="30"><Cell ss:StyleID="head"><Data ss:Type="String">Valores de Status</Data></Cell><Cell ss:StyleID="head"><Data ss:Type="String">Valores de Frente</Data></Cell><Cell ss:StyleID="head"><Data ss:Type="String">Perfis</Data></Cell></Row>
